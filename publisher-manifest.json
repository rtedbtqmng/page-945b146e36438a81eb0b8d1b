11px;letter-spacing: 0.22em;text-transform: uppercase;color: #8a5a17}\n\n    h2 {margin: 6px 0 0;font-family: var(--serif);font-size: clamp(1.6rem, 3.4vw, 2.4rem);line-height: 1.2}\n\n    .section-head p {margin: 0;color: #3f5161;font-size: 15px}\n\n    .article-grid {display: grid;grid-template-columns: repeat(12, minmax(0, 1fr));gap: 28px 40px}\n\n    .article-grid > .col-a {grid-column: 1 / span 7}\n    .article-grid > .col-b {grid-column: 8 / -1}\n    .article-grid > .col-c {grid-column: 1 / -1}\n\n    h3 {margin: 0 0 10px;font-family: var(--serif);font-size: 1.2rem;line-height: 1.4}\n\n    .muted {color: #4d6070}\n\n    .divider-spaced {margin-top: 26px;padding-top: 26px;border-top: 1px solid rgba(11, 31, 51, 0.12)}\n\n    .plans {background: var(--paper);border-top: 1px solid rgba(11, 31, 51, 0.1);border-bottom: 1px solid rgba(11, 31, 51, 0.1)}\n\n    .steps {display: grid;gap: 0;counter-reset: step}\n\n    .step {display: grid;grid-template-columns: minmax(0, 42px) minmax(0, 1fr) minmax(0, 0.9fr);gap: 12px 28px;align-items: start;padding: 26px 0;border-top: 1px solid rgba(11, 31, 51, 0.14)}\n\n    .step:last-child {border-bottom: 1px solid rgba(11, 31, 51, 0.14)}\n\n    .step .num {font-family: var(--mono);font-size: 22px;line-height: 1.1;color: #a3abaf}\n\n    .step .name {font-family: var(--serif);font-size: 1.35rem;font-weight: 700}\n\n    .step .price {display: block;margin-top: 4px;font-size: 14px;color: #5b4a2f}\n\n    .step .price strong {font-family: var(--mono);font-size: 1.05rem;color: var(--ink)}\n\n    .step ul {margin: 0;padding-left: 18px;color: #3f5161;font-size: 14.5px}\n\n    .step ul li {margin-bottom: 6px}\n\n    .step.featured {background: rgba(233, 162, 59, 0.1);padding-left: 18px;padding-right: 18px;margin-left: -18px;margin-right: -18px;border-left: 3px solid var(--amber)}\n\n    .badge {display: inline-block;margin-left: 10px;padding: 2px 8px;border: 1px solid #a87522;border-radius: 999px;font-family: var(--mono);font-size: 10px;letter-spacing: 0.14em;text-transform: uppercase;color: #7a5214;vertical-align: middle;background: rgba(233, 162, 59, 0.18)}\n\n    .plan-note {margin: 22px 0 0;padding: 14px 16px;border: 1px dashed rgba(11, 31, 51, 0.3);font-size: 13.5px;color: #435566}\n\n    .clients {display: grid;grid-template-columns: repeat(3, minmax(0, 1fr));gap: 24px 36px}\n\n    .client {border-top: 2px solid var(--deep-sea);padding-top: 16px}\n\n    .client .platform {font-family: var(--mono);font-size: 10px;letter-spacing: 0.2em;text-transform: uppercase;color: #8a5a17}\n\n    .client h3 {margin-top: 4px}\n\n    .client p {margin: 0 0 10px;font-size: 14.5px;color: #3f5161}\n\n    .client a {font-size: 13.5px;color: #0b1f33;text-decoration: none;border-bottom: 1px solid var(--amber);padding-bottom: 1px}\n\n    .client a:hover {color: #8a5a17}\n\n    .faq {background: var(--deep-sea);color: var(--ivory)}\n\n    .faq .section-head {border-bottom-color: var(--line)}\n\n    .faq .section-head .label {color: var(--amber)}\n    .faq .section-head p {color: var(--muted)}\n\n    .faq-groups {display: grid;grid-template-columns: repeat(2, minmax(0, 1fr));gap: 34px 56px}\n\n    .faq-group h3 {font-family: var(--mono);font-size: 11px;letter-spacing: 0.2em;text-transform: uppercase;color: var(--amber-soft);padding-bottom: 10px;border-bottom: 1px solid var(--line);margin-bottom: 6px}\n\n    .faq-group article {padding: 16px 0;border-bottom: 1px solid rgba(247, 244, 238, 0.12)}\n\n    .faq-group article:last-child {border-bottom: 0}\n\n    .faq-group .q {display: block;margin: 0 0 6px;font-family: var(--serif);font-size: 1.05rem;font-weight: 700;color: var(--ivory)}\n\n    .faq-group .a {margin: 0;font-size: 14.5px;color: #c6d2dd}\n\n    .footer {background: #07131f;color: var(--muted);padding: 34px 24px 42px;font-size: 13px}\n\n    .footer-inner {max-width: 1180px;margin: 0 auto;display: flex;flex-wrap: wrap;gap: 10px 32px;justify-content: space-between;align-items: baseline}\n\n    .footer strong {color: var(--ivory);letter-spacing: 0.1em}\n\n    .footer a {color: var(--amber-soft);text-decoration: none;border-bottom: 1px solid rgba(233, 162, 59, 0.5)}\n\n    @media (max-width: 900px) {\n      .hero-grid {grid-template-columns: 1fr}\n      .hero-panel {border-left: 0;padding-left: 0;border-top: 1px solid var(--line);padding-top: 22px}\n      .hero-quote {grid-template-columns: 1fr}\n      .section-head {grid-template-columns: 1fr;gap: 10px}\n      .article-grid > .col-a,\n      .article-grid > .col-b,\n      .article-grid > .col-c {grid-column: 1 / -1}\n      .clients {grid-template-columns: 1fr}\n      .faq-groups {grid-template-columns: 1fr}\n      .step {grid-template-columns: 36px 1fr}\n      .step ul {grid-column: 2 / -1}\n    }\n\n    @media (max-width: 620px) {\n      .topbar-inner {flex-direction: column;align-items: flex-start;gap: 8px}\n      .topnav {gap: 4px 14px}\n      .section {padding: 48px 18px}\n      .hero {padding: 40px 18px 56px}\n      .step.featured {margin-left: -12px;margin-right: -12px;padding-left: 12px;padding-right: 12px}\n    }\n  </style><header class=\"topbar\">\n    <div class=\"topbar-inner\">\n      <div class=\"wordmark\">CloudRocket <span>Service Brief</span></div>\n      <nav class=\"topnav\" aria-label=\"页面目录\">\n        <a href=\"#overview\">概览</a>\n        <a href=\"#plans\">套餐</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#usage\">使用流程</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </header>\n\n  <main>\n\n    <section class=\"hero\" id=\"overview\">\n      <div class=\"hero-grid\">\n        <div class=\"kicker\">CloudRocket / 说明文档 01</div>\n        <h1 id=\"brand-title\">CloudRocket：把套餐、客户端与使用边界写清楚</h1>\n        <p class=\"hero-lead\">\n          这份页面用于在订阅前核对信息。它不承诺无法验证的性能指标，也不使用模糊的修辞。你可以在下方找到<strong>套餐结构</strong>、<strong>客户端说明</strong>、<strong>使用流程</strong>以及按主题分组的常见问题。所有价格与权益均以本页列出的内容为准。\n        </p>\n        <aside class=\"hero-panel\" aria-label=\"页面信息摘要\">\n          <dl>\n            <dt>文档性质</dt>\n            <dd>产品说明页，非营销活动页</dd>\n            <dt>套餐数量</dt>\n            <dd>三档：基础版、旗舰版、团队版</dd>\n            <dt>内容核对</dt>\n            <dd>价格、权益、客户端与 FAQ 同页列出</dd>\n            <dt>更新方式</dt>\n            <dd>以本页当前版本为准，不作额外承诺</dd>\n          </dl>\n        </aside>\n        <figure class=\"hero-quote\">\n          <blockquote>\n            “一份好的说明，应该让人在做决定之前就知道自己买到了什么、没买到什么。”\n          </blockquote>\n          <figcaption>CloudRocket 编辑原则 / 克制表达</figcaption>\n        </figure>\n      </div>\n    </section>\n\n    <section class=\"section\">\n      <div class=\"section-inner\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"label\">阅读前提</div>\n            <h2 id=\"premise-title\">先确认适用范围，再阅读套餐细节</h2>\n          </div>\n          <p>\n            CloudRocket 的订阅服务按设备数量、流量额度与线路类型区分。本页所列为当前说明，不包含未列出的附加能力。若后续有调整，应以同页更新后的文字为准。\n          </p>\n        </div>\n\n        <div class=\"article-grid\">\n          <div class=\"col-a\">\n            <h3>套餐是按使用强度分层的，不是按“好坏”分层的</h3>\n            <p class=\"muted\">\n              基础版面向轻量使用，旗舰版覆盖多数个人场景，团队版面向多人共用与更高流量需求。选择时应优先看月流量、同时在线设备数以及所需线路类型，而不是单纯比较价格高低。\n            </p>\n            <p class=\"muted divider-spaced\">\n              本页不声称任何未在套餐列表中出现的节点数量、实测延迟、带宽数值或流媒体兼容清单。凡涉及具体线路与解锁范围，请以对应套餐的权益条目为准。\n            </p>\n          </div>\n          <div class=\"col-b\">\n            <h3>价格与年付说明</h3>\n            <p class=\"muted\">\n              三档套餐均提供月付与年付两种方式。年付价格已写入各套餐条目，便于横向核对。页面不设默认勾选，也不以倒计时或模糊折扣引导下单。\n            </p>\n            <p class=\"muted divider-spaced\">\n              套餐权益中出现的“支持”“优化”“解锁”等表述，均只在对应条目内生效，不自动延伸到其他套餐或客户端。\n            </p>\n          </div>\n          <div class=\"col-c\">\n            <h3>页面结构与阅读顺序</h3>\n            <p class=\"muted\">\n              建议先阅读套餐阶梯，确认预算与权益匹配；再查看客户端区块，核对设备覆盖；随后按使用流程完成配置；最后浏览按主题分组的常见问题，确认没有未决疑问。\n            </p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section plans\" id=\"plans\">\n      <div class=\"section-inner\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"label\">订阅选项</div>\n            <h2 id=\"plans-title\">三档套餐，按阶梯向上排列</h2>\n          </div>\n          <p>\n            以下为 CloudRocket 当前列出的套餐内容。旗舰版以标记提示其推荐位置，但三档均按同一说明格式呈现，便于逐条比较。\n          </p>\n        </div>\n\n        <div class=\"steps\">\n\n          <div class=\"step\">\n            <div class=\"num\">01</div>\n            <div>\n              <span class=\"name\">基础版</span>\n              <span class=\"price\"><strong>¥15/月</strong> · 按年付仅需 ¥150/年</span>\n            </div>\n            <ul>\n              <li>每月 100GB 流量额度</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n          </div>\n\n          <div class=\"step featured\">\n            <div class=\"num\">02</div>\n            <div>\n              <span class=\"name\">旗舰版</span><span class=\"badge\">推荐</span>\n              <span class=\"price\"><strong>¥35/月</strong> · 按年付仅需 ¥350/年</span>\n            </div>\n            <ul>\n              <li>每月 300GB 流量额度</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n          </div>\n\n          <div class=\"step\">\n            <div class=\"num\">03</div>\n            <div>\n              <span class=\"name\">团队版</span>\n              <span class=\"price\"><strong>¥85/月</strong> · 按年付仅需 ¥850/年</span>\n            </div>\n            <ul>\n              <li>每月 1000GB 流量额度</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n          </div>\n\n        </div>\n\n        <p class=\"plan-note\">\n          说明：以上价格与权益均取自本页列出的套餐内容，不含未展示的附加服务。年付价格以各条目文字为准。若对具体线路或客户端支持有疑问，请先查阅下方客户端与常见问题区块。\n        </p>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"clients\">\n      <div class=\"section-inner\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"label\">客户端说明</div>\n            <h2 id=\"clients-title\">客户端按平台划分，下载地址以官方发布为准</h2>\n          </div>\n          <p>\n            本页不提供下载按钮或外链，避免指向不可核实的地址。以下仅说明各平台客户端的定位与配置要点，具体获取方式请通过官方渠道确认。\n          </p>\n        </div>\n\n        <div class=\"clients\">\n\n          <article class=\"client\">\n            <div class=\"platform\">Desktop / Windows</div>\n            <h3>桌面客户端</h3>\n            <p>适合固定位置使用。安装后按引导填写订阅信息，客户端会读取套餐对应的线路与流量状态。建议在同一台设备上保留一份配置文件副本。</p>\n            <a href=\"#\">下载地址以官方发布为准</a>\n          </article>\n\n          <article class=\"client\">\n            <div class=\"platform\">Mobile / iOS</div>\n            <h3>iOS 客户端</h3>\n            <p>移动端以轻量使用为主。首次启动后需手动导入订阅链接或配置信息，导入路径以客户端内说明为准。更换设备时请留意同时在线设备数限制。</p>\n            <a href=\"#\">下载地址以官方发布为准</a>\n          </article>\n\n          <article class=\"client\">\n            <div class=\"platform\">Mobile / Android</div>\n            <h3>Android 客户端</h3>\n            <p>Android 版本同样需要导入订阅信息，配置流程与桌面端接近。若在省电策略较强的系统上使用，请注意后台运行限制对连接稳定性的影响。</p>\n            <a href=\"#\">下载地址以官方发布为准</a>\n          </article>\n\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"usage\">\n      <div class=\"section-inner\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"label\">使用流程</div>\n            <h2 id=\"usage-title\">从核对套餐到完成配置的四步说明</h2>\n          </div>\n          <p>\n            以下流程不依赖任何特定客户端版本，重点在于把信息核对清楚再进入配置环节。\n          </p>\n        </div>\n\n        <div class=\"article-grid\">\n          <div class=\"col-a\">\n            <h3>第一步：确认套餐与设备数量</h3>\n            <p class=\"muted\">\n              先统计需要同时在线的设备数量。基础版为 3 台，旗舰版为 5 台，团队版为 20 台。若实际设备数超过所选档位，应在订阅前调整套餐，而不是在配置后再处理。\n            </p>\n\n            <h3 class=\"divider-spaced\">第二步：获取订阅信息</h3>\n            <p class=\"muted\">\n              订阅信息通常以链接或配置文本形式提供。请通过官方渠道获取，不要使用来源不明的共享链接。获取后建议先在本机保存，再导入客户端。\n            </p>\n          </div>\n          <div class=\"col-b\">\n            <h3>第三步：在客户端中导入并检查</h3>\n            <p class=\"muted\">\n              导入完成后，检查客户端是否识别到套餐对应的线路与流量额度。若显示异常，先核对订阅信息是否完整，再查看客户端内提示，不建议反复重新导入。\n            </p>\n\n            <h3 class=\"divider-spaced\">第四步：按需使用并核对额度</h3>\n            <p class=\"muted\">\n              日常使用中可定期查看剩余流量与在线设备数。团队版涉及多人共用时，建议指定一名管理员统一维护订阅信息，避免重复配置产生冲突。\n            </p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section faq\" id=\"faq\">\n      <div class=\"section-inner\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"label\">常见问题</div>\n            <h2 id=\"faq-title\">按主题分组的问题与回答</h2>\n          </div>\n          <p>\n            以下回答仅针对本页已列出的套餐与客户端说明。未在本页出现的能力，不作额外解释。\n          </p>\n        </div>\n\n        <div class=\"faq-groups\">\n\n          <div class=\"faq-group\">\n            <h3>套餐与价格</h3>\n\n            <article>\n              <span class=\"q\">三档套餐的主要区别是什么？</span>\n              <p class=\"a\">区别集中在月流量、同时在线设备数与线路类型。基础版为 100GB 与 3 台设备，旗舰版为 300GB 与 5 台设备，团队版为 1000GB 与 20 台设备。更高档位还包含相应条目中写明的支持与节点说明。</p>\n            </article>\n\n            <article>\n              <span class=\"q\">年付价格是否会自动替代月付？</span>\n              <p class=\"a\">不会。月付与年付是并列的两种方式，页面同时列出两者价格，便于对照。是否选择年付取决于使用周期预估，页面不设置默认勾选。</p>\n            </article>\n\n            <article>\n              <span class=\"q\">为什么旗舰版被标记为推荐？</span>\n              <p class=\"a\">该标记仅表示在页面呈现上作为中间档位突出显示，便于比较。它不代表性能承诺，也不意味着其他两档不适合使用。</p>\n            </article>\n          </div>\n\n          <div class=\"faq-group\">\n            <h3>客户端与设备</h3>\n\n            <article>\n              <span class=\"q\">同时在线设备数如何计算？</span>\n              <p class=\"a\">按当前处于在线状态的设备数量计算，超过套餐上限时需要减少在线设备或调整套餐。不同平台共用同一上限，不按平台分别计算。</p>\n            </article>\n\n            <article>\n              <span class=\"q\">更换设备后需要重新配置吗？</span>\n              <p class=\"a\">需要在新设备上导入订阅信息。原设备上的配置可以保留，但若两边同时在线，会占用设备额度。建议在更换时先确认旧设备是否已退出。</p>\n            </article>\n\n            <article>\n              <span class=\"q\">为什么本页没有直接提供下载链接？</span>\n              <p class=\"a\">本页仅收录可核实的说明性内容，不指向未经确认的下载地址。客户端获取方式请以官方发布渠道为准，以免误用非官方版本。</p>\n            </article>\n          </div>\n\n          <div class=\"faq-group\">\n            <h3>线路与流量</h3>\n\n            <article>\n              <span class=\"q\">流量额度用完后会怎样？</span>\n              <p class=\"a\">本页仅列出各套餐的每月流量额度，不额外描述超量后的处理方式。若流量接近上限，建议先核对客户端内显示的使用情况，再决定是否调整套餐。</p>\n            </article>\n\n            <article>\n              <span class=\"q\">“普通线路”与“IPLC 专线”有什么区别？</span>\n              <p class=\"a\">两者在套餐条目中分别列出，对应不同的线路说明。本页不对其延迟、带宽或稳定性作数值承诺，具体使用感受受所在网络环境影响。</p>\n            </article>\n\n            <article>\n              <span class=\"q\">流媒体解锁范围是否适用于所有节点？</span>\n              <p class=\"a\">基础版条目为“解锁基础流媒体”，旗舰版条目为“全节点原生流媒体解锁”。两者表述不同，应按所选套餐的条目理解，不跨档位套用。</p>\n            </article>\n          </div>\n\n          <div class=\"faq-group\">\n            <h3>支持与维护</h3>\n\n            <article>\n              <span class=\"q\">旗舰版的优先工单支持指什么？</span>\n              <p class=\"a\">指该套餐条目中列出的 7x24 优先工单支持。本页不额外承诺响应时长或处理结果，具体以工单渠道的实际说明为准。</p>\n            </article>\n\n            <article>\n              <span class=\"q\">团队版是否必须由管理员统一管理？</span>\n              <p class=\"a\">不是强制要求，但多人共用 20 台设备额度时，建议指定管理员统一维护订阅信息，减少重复导入与设备冲突。专属客户经理服务已包含在该套餐条目中。</p>\n            </article>\n\n            <article>\n              <span class=\"q\">如果本页信息与实际界面不一致怎么办？</span>\n              <p class=\"a\">以实际订阅时确认的套餐条目为准。本页作为说明性文档，用于在订阅前核对价格、权益与客户端覆盖范围，不替代实际服务界面的提示。</p>\n            </article>\n          </div>\n\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"footer\">\n    <div class=\"footer-inner\">\n      <div><strong>CloudRocket</strong> · 服务说明页</div>\n      <div>套餐、客户端与常见问题均以本页文字为准 · <a href=\"#overview\">回到顶部</a></div>\n    </div>\n  </footer>",
